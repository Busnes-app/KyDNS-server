[Unit]
Description=KyDNS local DNS server and service directory
Documentation=https://github.com/Busnes-app/kydns-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kydns
Group=kydns
ExecStart=/usr/bin/kydns serve --config /etc/kydns/kydns.yaml
Restart=on-failure
RestartSec=5s

# Two privileged things: binding port 53 (and 67 when the built-in DHCP server
# is on), and the raw ICMPv6 socket the optional IPv6 DNS advertisement sends
# router advertisements from. DHCP needs no raw socket; every reply is
# broadcast. CAP_NET_RAW is granted even while the advertisement is off, so
# turning it on in the web UI needs no unit edit.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes

# The database and the first-run tokens. The only writable path.
StateDirectory=kydns
StateDirectoryMode=0700

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK: Go reads the interface table (DHCP's interface checks) over netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
